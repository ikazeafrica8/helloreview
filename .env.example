# HelloReview local development environment.
#
# Copy to .env (`pnpm services:up` does it for you on a fresh clone). .env is gitignored;
# this template is the only environment file in version control.
#
# EVERY VALUE HERE IS A LOCAL-ONLY PLACEHOLDER. Nothing in this file is, or may become, a real
# credential — SPEC.md §8 never permits committing secrets. Deployed environments get their values
# from a secret manager (SPEC.md §18.3), never from a file like this one.
#
# The URL variables duplicate the parts above them on purpose: Compose builds the containers from
# the parts, the application connects with the URLs. `pnpm services:up` runs a preflight that fails
# if the two ever disagree, because that combination produces a stack that reports healthy and an
# application that cannot connect.

# --- Application -------------------------------------------------------------------------------
# Which deployment this is. Every log line carries it (PRD §23.1), and development, test, staging and
# production must stay separated. Defaults to development if unset.
NODE_ENV=development

# Keys maskIdentifier(), which turns a Kakao user id into a pseudonymous log tag. An UNKEYED hash of
# a low-entropy identifier is reversible by brute force, so unlinkability depends entirely on this
# staying secret. A deployed environment MUST supply its own from a secret manager, never this value.
MASKING_PEPPER=helloreview_local_dev_pepper_not_for_deployment

# SPEC.md §4 names port 3000 for the API, but 3000 is commonly taken by another project's dev
# server, and two processes cannot bind one host port. Same treatment as the service ports below:
# parameterized here, with a default that does not collide. Set it to 3000 if that port is free
# for you. This deviation from §4 is recorded in tasks/todo.md under T4.
API_PORT=13000

# --- PostgreSQL ------------------------------------------------------------------------------
POSTGRES_USER=helloreview
POSTGRES_PASSWORD=helloreview_local_dev
POSTGRES_DB=helloreview

# Host ports deliberately avoid the standard 5432/6379/9000/9001. Two containers cannot bind the
# same host port, and a developer machine often already runs another project's stack on the
# defaults. Container-internal ports stay standard, so nothing inside the compose network changes.
POSTGRES_PORT=15432

# What the api and worker connect as.
DATABASE_URL=postgres://helloreview:helloreview_local_dev@127.0.0.1:15432/helloreview

# What OWNS the schema: migrations, db:reset, db:seed and drizzle-kit/studio.
#
# IDENTICAL to DATABASE_URL today, and that is the point. The two are separated now, while the
# separation is a no-op that cannot break anything, so that giving the application a restricted
# credential later is one line here rather than a refactor of every tool.
#
# Why it matters: the api and worker are long-running processes reachable from the internet, and
# they never need to drop a table or rewrite an audit row. Splitting the credentials means a bug or
# an injected query in the application cannot erase its own evidence. It does NOT restrict the
# human operator, who keeps this owner credential. See tasks/todo.md, "Least-privilege roles".
DATABASE_MIGRATION_URL=postgres://helloreview:helloreview_local_dev@127.0.0.1:15432/helloreview

# --- Redis -----------------------------------------------------------------------------------
REDIS_PASSWORD=helloreview_local_dev
REDIS_PORT=16379

# The `default:` username is required. redis-cli 7.x sends no AUTH for the empty-username form and
# fails with NOAUTH, so the URL would not work for manual debugging.
REDIS_URL=redis://default:helloreview_local_dev@127.0.0.1:16379/0

# --- MinIO (S3-compatible object storage) ------------------------------------------------------
# Root credentials administer the server and are used ONLY by the init container.
MINIO_ROOT_USER=helloreview_local_root
MINIO_ROOT_PASSWORD=helloreview_local_dev_root_pw

MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001

# The application uses this scoped service account, never the root credential, so local wiring has
# the same shape as a deployed S3 key and the storage adapter needs no local-only code path.
S3_BUCKET=helloreview-attachments
# MinIO rejects an access key outside 3–20 characters, and the failure only surfaces when the init
# container runs. Keep this at or under 20; the contract test enforces it.
S3_ACCESS_KEY_ID=hr_local_access_key
S3_SECRET_ACCESS_KEY=helloreview_local_dev_secret
S3_ENDPOINT=http://127.0.0.1:19000

# --- Webhook signing (PRD 18.3) ---------------------------------------------------------------
# The shared secret the website signs its webhooks with. This is the only thing between the
# internet and the ability to write business state, so a deployed environment MUST supply its own
# from a secret manager. A minimum of 32 characters is enforced: an attacker who captures one
# signed request can grind candidates against it offline, without touching us.
WEBHOOK_SECRET_WEBSITE=helloreview_local_dev_webhook_secret_not_for_deployment

# How old a signed webhook may be, in seconds. Too tight refuses a provider's legitimate retry;
# too loose leaves a captured request replayable for that long. Five minutes is the convention.
WEBHOOK_REPLAY_WINDOW_SECONDS=300
