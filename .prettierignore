# Prettier reformats anything it is pointed at, including files it has no business touching.
# `pnpm format` runs over the whole tree, so this list is what keeps it honest.

# Generated or vendored
node_modules/
dist/
build/
.next/
.turbo/
coverage/
.vitest/

# The lockfile is generated by pnpm and must stay byte-identical to what pnpm writes.
pnpm-lock.yaml

# Drizzle emits these and they are reviewed as migrations, not as source (T9).
packages/db/migrations/

# Reformatting a Korean participant-facing template risks changing what the participant sees.
# Templates are versioned business content under legal classification (PRD §21.9, §32).
**/message-templates/**

# Source requirements — kept byte-identical to what was delivered.
HelloReview Reviewer Campaign Automation Platform — Product Requirements Document.md
