{
  "name": "helloreview",
  "version": "0.0.0",
  "private": true,
  "description": "HelloReview Reviewer Campaign Automation Platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.22.0 || >=24"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:api": "node tools/dev-runner.mjs api",
    "dev:worker": "node tools/dev-runner.mjs worker",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "node infra/scripts/preflight.mjs && docker compose -f infra/docker-compose.yml --project-directory . up -d --wait --wait-timeout 180 && docker compose -f infra/docker-compose.yml --project-directory . run --rm -T minio-init",
    "services:down": "docker compose --profile init -f infra/docker-compose.yml --project-directory . down --remove-orphans",
    "services:reset": "docker compose --profile init -f infra/docker-compose.yml --project-directory . down -v --remove-orphans",
    "db:generate": "node tools/db-generate.mjs",
    "db:migrate": "node --env-file-if-exists=.env tools/db-migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env tools/db-reset.mjs",
    "db:seed": "node --env-file-if-exists=.env tools/db-seed.mjs",
    "db:check": "pnpm --filter @helloreview/db exec drizzle-kit check",
    "test": "vitest run --project unit --project transitions --project integration",
    "test:unit": "vitest run --project unit",
    "test:transitions": "vitest run --project transitions",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run test:transitions"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
